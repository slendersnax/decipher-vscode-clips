{
  "name": "decipher-vscode-clips",
  "displayName": "decipher-vscode-clips",
  "description": "Decipher snippets and commands for VS Code",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "decipher-xml",
        "aliases": [
          "Decipher XML"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "decipher-xml",
        "scopeName": "text.decipher.xml",
        "path": "./syntaxes/decipher-xml.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python",
          "text.html.basic": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "commands": [
      {
        "command": "decipher.makeRadio",
        "title": "Decipher: Make Radio"
      },
      {
        "command": "decipher.makeCheckbox",
        "title": "Decipher: Make Checkbox"
      },
      {
        "command": "decipher.makeSelect",
        "title": "Decipher: Make Select"
      },
      {
        "command": "decipher.makeTextarea",
        "title": "Decipher: Make Textarea"
      },
      {
        "command": "decipher.makeText",
        "title": "Decipher: Make Text"
      },
      {
        "command": "decipher.makeNumber",
        "title": "Decipher: Make Number"
      },
      {
        "command": "decipher.makePipe",
        "title": "Decipher: Make Pipe"
      },
      {
        "command": "decipher.makeComment",
        "title": "Decipher: Make Comment (<html>)"
      },
      {
        "command": "decipher.insertComment",
        "title": "Decipher: Insert <comment>"
      },
      {
        "command": "decipher.makeRows",
        "title": "Decipher: Make Rows"
      },
      {
        "command": "decipher.makeRowsWithValues",
        "title": "Decipher: Make Rows with Values"
      },
      {
        "command": "decipher.makeRowsMatchingLabels",
        "title": "Decipher: Make Rows with Labels from text"
      },
      {
        "command": "decipher.makeRowsMatchingValues",
        "title": "Decipher: Make Rows with Labels and Values from text"
      },
      {
        "command": "decipher.makeRowsReverse",
        "title": "Decipher: Make Rows with Labels Reversed"
      },
      {
        "command": "decipher.makeRowsWithValuesReverse",
        "title": "Decipher: Make Rows with Labels and Values Reversed"
      },
      {
        "command": "decipher.makeCols",
        "title": "Decipher: Make Cols"
      },
      {
        "command": "decipher.makeColsWithValues",
        "title": "Decipher: Make Cols with Values"
      },
      {
        "command": "decipher.makeColsMatchingLabels",
        "title": "Decipher: Make Cols with Labels from text"
      },
      {
        "command": "decipher.makeColsMatchingValues",
        "title": "Decipher: Make Cols with Labels and Values from text"
      },
      {
        "command": "decipher.makeColsReverse",
        "title": "Decipher: Make Cols with Labels Reversed"
      },
      {
        "command": "decipher.makeColsWithValuesReverse",
        "title": "Decipher: Make Cols with Labels and Values Reversed"
      },
      {
        "command": "decipher.makeChoices",
        "title": "Decipher: Make Choices"
      },
      {
        "command": "decipher.makeChoicesWithValues",
        "title": "Decipher: Make Choices with Values"
      },
      {
        "command": "decipher.makeChoicesMatchingLabels",
        "title": "Decipher: Make Choices with Labels from text"
      },
      {
        "command": "decipher.makeChoicesMatchingValues",
        "title": "Decipher: Make Choices with Labels and Values from text"
      },
      {
        "command": "decipher.makeChoicesReverse",
        "title": "Decipher: Make Choices with Labels Reversed"
      },
      {
        "command": "decipher.makeChoicesWithValuesReverse",
        "title": "Decipher: Make Choices with Labels and Values Reversed"
      },
      {
        "command": "decipher.makeCases",
        "title": "Decipher: Make Cases (for Pipe)"
      },
      {
        "command": "decipher.makeCasesMatchingLabels",
        "title": "Decipher: Make Cases (for Pipe) with Labels from text"
      },
      {
        "command": "decipher.makeGroups",
        "title": "Decipher: Make Groups"
      },
      {
        "command": "decipher.makeGroupsMatchingLabels",
        "title": "Decipher: Make Groups with Labels from text"
      },

      {
        "command": "decipher.switchRowsCols",
        "title": "Decipher: Switch Rows and Cols"
      },
      {
        "command": "decipher.switchRowsChoices",
        "title": "Decipher: Switch Rows and Choices"
      },
      {
        "command": "decipher.switchColsChoices",
        "title": "Decipher: Switch Cols and Choices"
      },

      {
        "command": "decipher.boldText",
        "title": "Decipher: insert Bold Text"
      },
      {
        "command": "decipher.italicText",
        "title": "Decipher: insert Italic Text"
      },
      {
        "command": "decipher.underlineText",
        "title": "Decipher: insert Underline Text"
      }
    ],
    "snippets": [
      {
        "language": "decipher-xml",
        "path": "./snippets/decipher-xml.code-snippets"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeRadio",
        "key": "ctrl+r",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeCheckbox",
        "key": "ctrl+shift+c",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeSelect",
        "key": "ctrl+shift+s",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeText",
        "key": "ctrl+t",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeTextarea",
        "key": "ctrl+shift+t",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeNumber",
        "key": "ctrl+shift+n",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makePipe",
        "key": "ctrl+p",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeComment",
        "key": "ctrl+shift+h",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.insertComment",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeRows",
        "key": "ctrl+1",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeRowsWithValues",
        "key": "ctrl+shift+1",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeRowsMatchingLabels",
        "key": "ctrl+9",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeRowsMatchingValues",
        "key": "ctrl+shift+9",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeCols",
        "key": "ctrl+2",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeColsWithValues",
        "key": "ctrl+shift+2",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeColsMatchingLabels",
        "key": "ctrl+8",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeColsMatchingValues",
        "key": "ctrl+shift+8",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeChoices",
        "key": "ctrl+3",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeChoicesWithValues",
        "key": "ctrl+shift+3",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeChoicesMatchingLabels",
        "key": "ctrl+7",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeChoicesMatchingValues",
        "key": "ctrl+shift+7",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeCases",
        "key": "ctrl+4",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeCasesMatchingLabels",
        "key": "ctrl+shift+4",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeGroups",
        "key": "ctrl+5",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.makeGroupsMatchingLabels",
        "key": "ctrl+shift+5",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.switchRowsCols",
        "key": "ctrl+shift+f12",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.boldText",
        "key": "shift+alt+b",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.italicText",
        "key": "shift+alt+i",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      },
      {
        "command": "decipher.underlineText",
        "key": "shift+alt+u",
        "when": "editorTextFocus && editorLangId == 'decipher-xml'",
        "category": "Decipher"
      }
    ],
    "submenus": [
      {
        "id": "decipher.questionTypes",
        "label": "Dec: Question Types"
      },
      {
        "id": "decipher.elementTypes",
        "label": "Dec: Question Elements"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "decipher.questionTypes",
          "when": "editorLangId == decipher-xml",
          "group": "decipher@1"
        },
        {
          "submenu": "decipher.elementTypes",
          "when": "editorLangId == decipher-xml",
          "group": "decipher@2"
        }
      ],
      "decipher.questionTypes": [
        {
          "command": "decipher.makeRadio",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@1"
        },
        {
          "command": "decipher.makeCheckbox",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@2"
        },
        {
          "command": "decipher.makeSelect",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@3"
        },
        {
          "command": "decipher.makeText",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@4"
        },
        {
          "command": "decipher.makeTextarea",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@5"
        },
        {
          "command": "decipher.makeNumber",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@6"
        },
        {
          "command": "decipher.makeComment",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@7"
        },
        {
          "command": "decipher.makePipe",
          "when": "editorLangId == decipher-xml",
          "group": "questionTypes@8"
        }
      ],
      "decipher.elementTypes": [
        {
          "command": "decipher.makeRows",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@1"
        },
        {
          "command": "decipher.makeRowsWithValues",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@2"
        },
        {
          "command": "decipher.makeCols",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@3"
        },
        {
          "command": "decipher.makeColsWithValues",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@4"
        },
        {
          "command": "decipher.makeChoices",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@5"
        },
        {
          "command": "decipher.makeChoicesWithValues",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@6"
        },
        {
          "command": "decipher.makeCases",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@7"
        },
        {
          "command": "decipher.makeCasesMatchingLabels",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@8"
        },
        {
          "command": "decipher.makeGroups",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@9"
        },
        {
          "command": "decipher.makeGroupsMatchingLabels",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@10"
        },
        {
          "command": "decipher.makeChoicesMatchingLabels",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@11"
        },
        {
          "command": "decipher.makeChoicesMatchingValues",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@12"
        },
        {
          "command": "decipher.makeColsMatchingLabels",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@13"
        },
        {
          "command": "decipher.makeColsMatchingValues",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@14"
        },
        {
          "command": "decipher.makeRowsMatchingLabels",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@15"
        },
        {
          "command": "decipher.makeRowsMatchingValues",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@16"
        },
        {
          "command": "decipher.switchRowsCols",
          "when": "editorLangId == decipher-xml",
          "group": "elementTypes@17"
        }
      ]
    },
    "configurationDefaults": {
      "[decipher-xml]": {
        "editor.tabCompletion": "on",
        "editor.acceptSuggestionOnEnter": "off",
        "editor.acceptSuggestionOnCommitCharacter": false,
        "editor.snippetSuggestions": "top",
        "editor.autoClosingQuotes": "always",
        "editor.insertSpaces": true,
        "editor.renderLineHighlight": "all",
        "editor.stickyScroll.enabled": false,
        "editor.wordWrap": "on"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
